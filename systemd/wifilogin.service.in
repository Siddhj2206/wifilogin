[Unit]
Description=Event-driven captive portal auto-login (wifilogin)
# Generated by `wifilogin service install`. Hand-editing is pointless —
# re-run install after upgrades to refresh the ExecStart path.

[Service]
Type=simple
ExecStart=@EXE@ run
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info
@EXTRA_ENV@
# Keyring access (secret service / gnome-keyring) requires an unlocked
# session keyring. If credentials fail only under systemd, check your
# distro's PAM keyring unlock setup.

# Sandbox hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
