[Unit]
Description=Event-driven captive portal auto-login (wifilogin)
# Generated by `wifilogin setup`. Hand-editing is pointless —
# re-run setup after upgrades to refresh the ExecStart path.
# Fedora 45+ provides the Secret Service from oo7-daemon. Both units are
# pulled in by default.target, so order after it; otherwise wifilogin can win
# the race and reach the keyring before org.freedesktop.secrets exists.
# This unit is absent on systems that still use gnome-keyring.
After=oo7-daemon.service

[Service]
Type=simple
ExecStart=@EXE@ run
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info
# Keyring access (secret service / gnome-keyring) requires an unlocked
# session keyring. If credentials fail only under systemd, check your
# distro's PAM keyring unlock setup.

# Sandbox hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
